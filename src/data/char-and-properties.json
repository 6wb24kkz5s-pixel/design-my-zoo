  "rules": {
    "nullProperty": "null means the property is not shown or tested for that material.",
    "home": "Each inner list is 'any one of these'. All inner lists must be met.",
    "water": "Any one listed source, inside the same enclosure, that passes its material check.",
    "air": "Full unless the enclosure has a roof that does not let air through. Animals with livesInWater must stand on water squares.",
    "safety": "Enclosure closed and every fence piece strong. small: no fence piece with big gaps. flies: needs a roof; flies + small: roof gaps must be 'small'. Animals with livesInWater count as safe while in a pool. No animal it shares with is in its 'eats' list, and it is not in any neighbour's 'eats' list.",
    "visitorView": "great = any transparent fence piece, or a transparent pool holding fish; okay = big-gap fence pieces only; none = otherwise."
  }
